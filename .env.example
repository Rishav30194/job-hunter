# Database
POSTGRES_PASSWORD=your_strong_password_here
DATABASE_URL=postgresql://jobhunter:your_strong_password_here@postgres:5432/job_hunter

# Redis
REDIS_URL=redis://redis:6379/0

# Anthropic (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram (BotFather token + your chat ID)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# LinkedIn credentials (for recruiter tracing — Phase 8)
LINKEDIN_EMAIL=your_email@gmail.com
LINKEDIN_PASSWORD=your_linkedin_password

# Indeed credentials (for auto-apply — Phase 7)
INDEED_EMAIL=your_indeed_email@gmail.com
INDEED_PASSWORD=your_indeed_password
RESUME_PATH=/absolute/path/to/resume.pdf

# Brave Search MCP (get free key at brave.com/search/api)
BRAVE_API_KEY=your_brave_api_key

# Google OAuth (for Gmail MCP + Google Calendar MCP)
# Setup: console.cloud.google.com → OAuth2 → enable Gmail + Calendar APIs
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Notion MCP (create integration at notion.so/my-integrations)
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=your_kanban_database_id

# Playwright MCP
PLAYWRIGHT_HEADLESS=true

# Thresholds (adjust as needed)
HUMAN_REVIEW_THRESHOLD=85
AUTO_APPLY_THRESHOLD=75
MAX_AUTO_APPLIES_PER_DAY=20
MAX_HUMAN_REVIEW_PER_RUN=5
FETCH_INTERVAL_HOURS=6
JOB_MAX_AGE_HOURS=48
MIN_SALARY=100000
