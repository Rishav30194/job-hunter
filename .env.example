# Database
POSTGRES_PASSWORD=your_strong_password_here
DATABASE_URL=postgresql://jobhunter:your_strong_password_here@postgres:5432/job_hunter


# Anthropic (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Model for scoring and email classification. Prompts and thresholds are tuned for Haiku 5.5.
CLAUDE_MODEL=claude-haiku-5-5

# Telegram (BotFather token + your chat ID)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# JSearch via RapidAPI (Google for Jobs)
# Free tier: 200 requests/month — subscribe at rapidapi.com → search "JSearch"
RAPIDAPI_KEY=your_rapidapi_key_here

# Google OAuth (Gmail feedback loop)
# Setup: console.cloud.google.com → OAuth2 → Desktop app → enable Gmail API
# One-time token: PYTHONPATH=. venv/bin/python src/feedback/setup_gmail.py
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Pipeline thresholds, calibrated for Haiku 5.5 (docs/haiku-5-5-upgrade-plan-2026-10-10.md, Phase 3)
HIGH_MATCH_THRESHOLD=80
AUTO_APPLY_THRESHOLD=70
MAX_QUEUED_PER_DAY=20
FETCH_INTERVAL_HOURS=6
JOB_MAX_AGE_HOURS=48
MIN_SALARY=100000
